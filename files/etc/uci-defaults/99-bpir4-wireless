#!/bin/sh

[ "$(board_name)" = "bananapi,bpi-r4" ] || exit 0

wifi_path='soc/11300000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0'
wifi_key='12345678'

uci set wireless.radio0=wifi-device
uci set wireless.radio0.type='mac80211'
uci set wireless.radio0.path="$wifi_path"
uci set wireless.radio0.radio='0'
uci set wireless.radio0.band='2g'
uci set wireless.radio0.channel='auto'
uci set wireless.radio0.htmode='HE20'
uci set wireless.radio0.country='AU'
uci set wireless.radio0.txpower='28'
uci set wireless.radio0.disabled='0'
uci set wireless.radio0.he_mu_beamformer='0'
uci set wireless.radio0.he_su_beamformer='1'

uci set wireless.default_radio0=wifi-iface
uci set wireless.default_radio0.device='radio0'
uci set wireless.default_radio0.network='lan'
uci set wireless.default_radio0.mode='ap'
uci set wireless.default_radio0.ssid='BPI-R4-2G'
uci set wireless.default_radio0.encryption='psk2'
uci set wireless.default_radio0.key="$wifi_key"
uci set wireless.default_radio0.disabled='0'

uci set wireless.radio1=wifi-device
uci set wireless.radio1.type='mac80211'
uci set wireless.radio1.path="$wifi_path"
uci set wireless.radio1.radio='1'
uci set wireless.radio1.band='5g'
uci set wireless.radio1.channel='36'
uci set wireless.radio1.htmode='EHT160'
uci set wireless.radio1.country='AU'
uci set wireless.radio1.txpower='30'
uci set wireless.radio1.disabled='0'
uci set wireless.radio1.he_su_beamformer='1'
uci set wireless.radio1.he_mu_beamformer='1'
uci set wireless.radio1.eht_su_beamformer='1'
uci set wireless.radio1.eht_mu_beamformer='1'
uci set wireless.radio1.he_bss_color='2'
uci set wireless.radio1.radar_background='1'

uci set wireless.default_radio1=wifi-iface
uci set wireless.default_radio1.device='radio1'
uci set wireless.default_radio1.network='lan'
uci set wireless.default_radio1.mode='ap'
uci set wireless.default_radio1.ssid='BPI-R4'
uci set wireless.default_radio1.encryption='sae-mixed'
uci set wireless.default_radio1.key="$wifi_key"
uci set wireless.default_radio1.disabled='0'

uci set wireless.radio2=wifi-device
uci set wireless.radio2.type='mac80211'
uci set wireless.radio2.path="$wifi_path"
uci set wireless.radio2.radio='2'
uci set wireless.radio2.band='6g'
uci set wireless.radio2.channel='37'
uci set wireless.radio2.htmode='EHT320'
uci set wireless.radio2.country='AU'
uci set wireless.radio2.txpower='30'
uci set wireless.radio2.disabled='0'
uci set wireless.radio2.eht_su_beamformer='1'
uci set wireless.radio2.eht_mu_beamformer='1'
uci set wireless.radio2.he_su_beamformer='1'
uci set wireless.radio2.he_mu_beamformer='1'
uci set wireless.radio2.he_bss_color='1'
uci set wireless.radio2.he_twt_responder='1'

uci set wireless.default_radio2=wifi-iface
uci set wireless.default_radio2.device='radio2'
uci set wireless.default_radio2.network='lan'
uci set wireless.default_radio2.mode='ap'
uci set wireless.default_radio2.ssid='BPI-R4-6G'
uci set wireless.default_radio2.encryption='sae'
uci set wireless.default_radio2.key="$wifi_key"
uci set wireless.default_radio2.disabled='0'

uci commit wireless

exit 0
