#!/bin/sh

[ "$(board_name)" = "bananapi,bpi-r4" ] || exit 0

uci -q batch <<-EOF
set firewall.ha_web=redirect
set firewall.ha_web.name='ha_web'
set firewall.ha_web.target='DNAT'
set firewall.ha_web.src='wan'
set firewall.ha_web.dest='lan'
set firewall.ha_web.proto='tcp'
set firewall.ha_web.src_dport='47189'
set firewall.ha_web.dest_ip='192.168.50.1'
set firewall.ha_web.dest_port='8443'
set firewall.ha_web.enabled='1'

set firewall.ha_web_lan=redirect
set firewall.ha_web_lan.name='ha_web_lan'
set firewall.ha_web_lan.target='DNAT'
set firewall.ha_web_lan.src='lan'
set firewall.ha_web_lan.dest='lan'
set firewall.ha_web_lan.proto='tcp'
set firewall.ha_web_lan.src_dport='47189'
set firewall.ha_web_lan.dest_ip='192.168.50.1'
set firewall.ha_web_lan.dest_port='8443'
set firewall.ha_web_lan.enabled='1'

set firewall.luci_remote=redirect
set firewall.luci_remote.name='luci_remote'
set firewall.luci_remote.target='DNAT'
set firewall.luci_remote.src='wan'
set firewall.luci_remote.dest='lan'
set firewall.luci_remote.proto='tcp'
set firewall.luci_remote.src_dport='58345'
set firewall.luci_remote.dest_ip='192.168.50.1'
set firewall.luci_remote.dest_port='8444'
set firewall.luci_remote.enabled='1'

commit firewall
EOF

exit 0
