#!/bin/sh

[ "$(board_name)" = "bananapi,bpi-r4" ] || exit 0

uci set system.led_wlan2g=led
uci set system.led_wlan2g.name='wlan2g'
uci set system.led_wlan2g.sysfs='mt76-2g'
uci set system.led_wlan2g.trigger='netdev'
uci set system.led_wlan2g.dev='phy0.0-ap0'
uci set system.led_wlan2g.mode='link tx rx'

uci set system.led_wlan5g=led
uci set system.led_wlan5g.name='wlan5g'
uci set system.led_wlan5g.sysfs='mt76-5g'
uci set system.led_wlan5g.trigger='netdev'
uci set system.led_wlan5g.dev='phy0.1-ap0'
uci set system.led_wlan5g.mode='link tx rx'

uci set system.led_wlan6g=led
uci set system.led_wlan6g.name='wlan6g'
uci set system.led_wlan6g.sysfs='mt76-6g'
uci set system.led_wlan6g.trigger='netdev'
uci set system.led_wlan6g.dev='phy0.2-ap0'
uci set system.led_wlan6g.mode='link tx rx'

uci commit system

exit 0
