+/* BE14 上的 2G/5G/6G 三颗蓝灯接在 MT7996 的 LED 引脚上，一个 band 一根，
+ * 寄存器都在同一个窗口里，所以直接从主芯片这边给三颗都注册 LED 设备。
+ */
+static int mt7996_register_band_leds(struct mt7996_dev *dev)
+{
+	struct device_node *led_np;
+	bool al = false;
+	u8 band;
+
+	led_np = of_get_child_by_name(dev->mt76.dev->of_node, "led");
+	if (led_np) {
+		al = of_property_read_bool(led_np, "led-active-low");
+		of_node_put(led_np);
+	}
+
+	for (band = 0; band < MT7996_MAX_RADIOS; band++) {
+		struct mt7996_band_led *led = &dev->band_leds[band];
+		int ret;
+
+		led->dev = dev;
+		led->band = band;
+		led->al = al;
+		snprintf(led->name, sizeof(led->name), "mt76-%s",
+			 mt7996_band_led_names[band]);
+		led->cdev.name = led->name;
+		led->cdev.max_brightness = 1;
+		led->cdev.brightness_set = mt7996_band_led_set_brightness;
+		led->cdev.blink_set = mt7996_band_led_blink_set;
+		led->cdev.default_trigger = "default-on";
+
+		ret = led_classdev_register(dev->mt76.dev, &led->cdev);
+		if (ret) {
+			dev_err(dev->mt76.dev,
+				"band led %d register failed: %d\n", band, ret);
+			led->cdev.name = NULL;
+			continue;
+		}
+
+		dev_info(dev->mt76.dev, "registered band led '%s'\n", led->name);
+	}
 
 	return 0;
 }
 
