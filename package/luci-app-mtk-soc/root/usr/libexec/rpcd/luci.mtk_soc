#!/bin/sh

. /usr/share/libubox/jshn.sh

CPU_POLICY=/sys/devices/system/cpu/cpufreq/policy0

read_file() {
	local value
	[ -r "$1" ] || return 1
	read -r value < "$1" 2>/dev/null || return 1
	printf '%s' "$value"
}

dt_string() {
	[ -e "$1" ] || return 1
	tr '\0' '\n' < "$1" 2>/dev/null | sed -n '1p'
}

read_num() {
	local value
	value=$(read_file "$1") || { printf '%s' '-1'; return; }
	case "$value" in
		''|*[!0-9-]*) printf '%s' '-1' ;;
		*) printf '%s' "$value" ;;
	esac
}

hwmon_temp() {
	local wanted="$1" h
	for h in /sys/class/hwmon/hwmon*; do
		[ -d "$h" ] || continue
		[ "$(read_file "$h/name")" = "$wanted" ] || continue
		read_num "$h/temp1_input"
		return
	done
	printf '%s' '-1'
}

hwmon_value() {
	local wanted="$1" file="$2" h
	for h in /sys/class/hwmon/hwmon*; do
		[ -d "$h" ] || continue
		[ "$(read_file "$h/name")" = "$wanted" ] || continue
		read_num "$h/$file"
		return
	done
	printf '%s' '-1'
}

thermal_trips() {
	local zone="$1" f t v warn=-1 hot=-1 crit=-1
	for f in "$zone"/trip_point_*_temp; do
		[ -r "$f" ] || continue
		t=$(read_file "${f%_temp}_type")
		v=$(read_num "$f")
		[ "$v" -ge 0 ] || continue
		case "$t" in
			critical)
				[ "$crit" -lt 0 ] && crit=$v
				;;
			hot)
				[ "$hot" -lt 0 ] && hot=$v
				;;
			active)
				# 高温降频/风扇档位: 取不低于 60°C 的最低档作为告警阈值
				if [ "$v" -ge 60000 ] && { [ "$warn" -lt 0 ] || [ "$v" -lt "$warn" ]; }; then
					warn=$v
				fi
				;;
		esac
	done
	printf '%s %s %s\n' "$warn" "$hot" "$crit"
}

ppe_summary() {
	local file="$1"
	[ -r "$file" ] || { printf '%s %s %s %s %s\n' -1 -1 -1 -1 -1; return; }
	awk '
		/^[0-9a-fA-F]+ / {
			total++
			if ($2 == "BND") {
				bound++
				for (i = 1; i <= NF; i++) {
					if ($i ~ /^packets=/) { sub(/^packets=/, "", $i); packets += $i }
					if ($i ~ /^bytes=/) { sub(/^bytes=/, "", $i); bytes += $i }
				}
			} else {
				unbound++
			}
		}
		END { printf "%d %d %d %.0f %.0f\n", total, bound, unbound, packets, bytes }
	' "$file"
}

add_string_list() {
	local key="$1" values="$2" item
	json_add_array "$key"
	for item in $values; do
		json_add_string "" "$item"
	done
	json_close_array
}

port_path() {
	case "$1" in
		sfp-wan) echo 'SFP+ WAN' ;;
		sfp-lan) echo 'SFP+ LAN' ;;
		wan) echo 'RJ45 WAN' ;;
		lan1) echo 'GbE LAN1' ;;
		lan2) echo 'GbE LAN2' ;;
		lan3) echo 'GbE LAN3' ;;
		lan4) echo 'GbE LAN4' ;;
		*) echo "$1" ;;
	esac
}

get_status() {
	local ppe governor governor_list freq_list ticks

	governor=$(read_file "$CPU_POLICY/scaling_governor")
	governor_list=$(read_file "$CPU_POLICY/scaling_available_governors")
	freq_list=$(read_file "$CPU_POLICY/scaling_available_frequencies")
	ticks=$(awk '
		/^cpu[0-9]+[ \t]/ {
			total = 0
			for (i = 2; i <= 9; i++)
				total += $i
			printf "%d %d ", total, $5 + $6
		}
	' /proc/stat 2>/dev/null)

	json_init
	json_add_string model "$(dt_string /proc/device-tree/model)"
	json_add_string compatible "$(dt_string /proc/device-tree/compatible)"
	json_add_string hostname "$(read_file /proc/sys/kernel/hostname)"
	json_add_string kernel "$(uname -r)"
	json_add_int uptime "$(cut -d. -f1 /proc/uptime 2>/dev/null || echo -1)"
	json_add_int cpu_count "$(grep -c '^processor' /proc/cpuinfo 2>/dev/null || echo 0)"
	json_add_string cpu_model 'ARM Cortex-A73 (MT7988A)'
	json_add_string cpu_arch 'ARMv8 (aarch64)'
	json_add_int cpu_temp_mc "$(read_num /sys/class/thermal/thermal_zone0/temp)"
	set -- $(thermal_trips /sys/class/thermal/thermal_zone0)
	json_add_int cpu_temp_warn_mc "$1"
	json_add_int cpu_temp_hot_mc "$2"
	json_add_int cpu_temp_crit_mc "$3"
	json_add_int cpu_cur_freq "$(read_num "$CPU_POLICY/scaling_cur_freq")"
	json_add_int cpu_min_freq "$(read_num "$CPU_POLICY/scaling_min_freq")"
	json_add_int cpu_max_freq "$(read_num "$CPU_POLICY/scaling_max_freq")"
	json_add_int cpu_hw_freq "$(read_num "$CPU_POLICY/cpuinfo_cur_freq")"
	json_add_string cpu_governor "${governor:-unknown}"
	add_string_list cpu_available_governors "$governor_list"
	add_string_list cpu_available_freqs "$freq_list"
	json_add_array cpu_ticks
	set -- $ticks
	while [ "$#" -ge 2 ]; do
		json_add_object
		json_add_int total "$1"
		json_add_int idle "$2"
		json_close_object
		shift 2
	done
	json_close_array
	json_add_int fan_pwm "$(hwmon_value pwmfan pwm1)"
	json_add_int fan_rpm "$(hwmon_value pwmfan fan1_input)"
	json_add_int sfp1_temp_mc "$(hwmon_temp sfp1)"
	json_add_int sfp1_temp_max_mc "$(hwmon_value sfp1 temp1_max)"
	json_add_int sfp1_temp_crit_mc "$(hwmon_value sfp1 temp1_crit)"
	json_add_int sfp1_temp_alarm "$(hwmon_value sfp1 temp1_crit_alarm)"
	json_add_int sfp2_temp_mc "$(hwmon_temp sfp2)"
	json_add_int sfp2_temp_max_mc "$(hwmon_value sfp2 temp1_max)"
	json_add_int sfp2_temp_crit_mc "$(hwmon_value sfp2 temp1_crit)"
	json_add_int sfp2_temp_alarm "$(hwmon_value sfp2 temp1_crit_alarm)"

	json_add_object clocks
	json_add_int npu_tops "$(read_num /sys/kernel/debug/clk/npu_tops_sel/clk_rate)"
	json_add_int ck_npu "$(read_num /sys/kernel/debug/clk/ck_npu_sel/clk_rate)"
	json_add_int ethdma_fe "$(read_num /sys/kernel/debug/clk/ethdma_fe_en/clk_rate)"
	json_close_object

	json_add_object ppe
	for ppe in ppe0 ppe1 ppe2; do
		set -- $(ppe_summary "/sys/kernel/debug/$ppe/entries")
		json_add_object "$ppe"
		json_add_int total "$1"
		json_add_int bound "$2"
		json_add_int unbound "$3"
		json_add_int packets "$4"
		json_add_int bytes "$5"
		json_close_object
	done
	json_close_object
	json_dump
}

get_ports() {
	local port speed carrier duplex operstate mac

	json_init
	json_add_array ports
	for port in sfp-wan sfp-lan wan lan1 lan2 lan3 lan4; do
		[ -d "/sys/class/net/$port" ] || continue
		speed=$(read_num "/sys/class/net/$port/speed")
		carrier=$(read_file "/sys/class/net/$port/carrier")
		duplex=$(read_file "/sys/class/net/$port/duplex")
		operstate=$(read_file "/sys/class/net/$port/operstate")
		mac=$(read_file "/sys/class/net/$port/address")

		json_add_object
		json_add_string name "$port"
		json_add_string path "$(port_path "$port")"
		json_add_string state "${operstate:-unknown}"
		json_add_boolean up "$([ "$carrier" = "1" ] && echo 1 || echo 0)"
		json_add_int speed_mbps "$speed"
		json_add_string duplex "${duplex:-unknown}"
		json_add_string mac "${mac:-}"
		json_add_int rx_bytes "$(read_num "/sys/class/net/$port/statistics/rx_bytes")"
		json_add_int tx_bytes "$(read_num "/sys/class/net/$port/statistics/tx_bytes")"
		json_add_int rx_packets "$(read_num "/sys/class/net/$port/statistics/rx_packets")"
		json_add_int tx_packets "$(read_num "/sys/class/net/$port/statistics/tx_packets")"
		json_add_int rx_errors "$(read_num "/sys/class/net/$port/statistics/rx_errors")"
		json_add_int tx_errors "$(read_num "/sys/class/net/$port/statistics/tx_errors")"
		json_add_int rx_dropped "$(read_num "/sys/class/net/$port/statistics/rx_dropped")"
		json_add_int tx_dropped "$(read_num "/sys/class/net/$port/statistics/tx_dropped")"
		json_close_object
	done
	json_close_array
	json_dump
}

get_ppe_entries() {
	local engine index state type orig new eth vlan packets bytes count=0

	json_init
	json_add_boolean available 1
	json_add_array entries
	for engine in ppe0 ppe1 ppe2; do
		[ -r "/sys/kernel/debug/$engine/entries" ] || continue
		while IFS='	' read -r index state type orig new eth vlan packets bytes; do
			[ -n "$index" ] || continue
			case "$packets" in ''|*[!0-9]*) packets=0 ;; esac
			case "$bytes" in ''|*[!0-9]*) bytes=0 ;; esac
			json_add_object
			json_add_string engine "$engine"
			json_add_string index "$index"
			json_add_string state "$state"
			json_add_string type "$type"
			json_add_string orig "$orig"
			json_add_string new_flow "$new"
			json_add_string eth "$eth"
			json_add_string vlan "$vlan"
			json_add_int packets "$packets"
			json_add_int bytes "$bytes"
			json_close_object
			count=$((count + 1))
			[ "$count" -ge 400 ] && break 2
		done <<-EOF
		$(awk '
			/^[0-9a-fA-F]+ / {
				idx=$1; state=$2; type=$3 " " $4
				orig=new=eth=vlan=packets=bytes=""
				for (i = 1; i <= NF; i++) {
					if ($i ~ /^orig=/) { orig=substr($i, 6) }
					else if ($i ~ /^new=/) { new=substr($i, 5) }
					else if ($i ~ /^eth=/) { eth=substr($i, 5) }
					else if ($i ~ /^vlan=/) { vlan=substr($i, 6) }
					else if ($i ~ /^packets=/) { packets=substr($i, 9) }
					else if ($i ~ /^bytes=/) { bytes=substr($i, 7) }
				}
				printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", idx, state, type, orig, new, eth, vlan, packets, bytes
			}
		' "/sys/kernel/debug/$engine/entries" 2>/dev/null)
		EOF
	done
	json_close_array
	json_dump
}

set_cpu_settings() {
	local payload="$1" governor max_freq

	# rpcd(exec 后端) 通过 stdin 传递调用参数, 直接执行脚本时才用 $1
	if [ -z "$payload" ]; then
		IFS= read -r payload
	fi
	json_load "$payload"
	json_get_var governor governor
	json_get_var max_freq max_freq

	if [ -n "$governor" ] && grep -qw "$governor" "$CPU_POLICY/scaling_available_governors" 2>/dev/null; then
		echo "$governor" > "$CPU_POLICY/scaling_governor" 2>/dev/null || true
	else
		governor=""
	fi

	if [ -n "$max_freq" ] && grep -qw "$max_freq" "$CPU_POLICY/scaling_available_frequencies" 2>/dev/null; then
		echo "$max_freq" > "$CPU_POLICY/scaling_max_freq" 2>/dev/null || true
	else
		max_freq=""
	fi

	if [ -n "$governor" ] || [ -n "$max_freq" ]; then
		/sbin/uci -q set mtk_soc.cpu=mtk_soc
		[ -n "$governor" ] && /sbin/uci -q set mtk_soc.cpu.governor="$governor"
		[ -n "$max_freq" ] && /sbin/uci -q set mtk_soc.cpu.max_freq="$max_freq"
		/sbin/uci -q commit mtk_soc
	fi

	json_init
	json_add_boolean ok 1
	json_dump
}

case "$1" in
	list)
		echo '{"getStatus":{},"getPorts":{},"getPpeEntries":{},"setCpuSettings":{"governor":"String","max_freq":"Integer"}}'
		;;
	call)
		case "$2" in
			getStatus) get_status ;;
			getPorts) get_ports ;;
			getPpeEntries) get_ppe_entries ;;
			setCpuSettings) set_cpu_settings "$3" ;;
		esac
		;;
esac
