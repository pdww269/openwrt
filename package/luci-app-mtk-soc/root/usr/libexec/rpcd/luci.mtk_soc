#!/bin/sh

. /usr/share/libubox/jshn.sh

CPU_POLICY=/sys/devices/system/cpu/cpufreq/policy0
STATE_DIR=/tmp/mtk-soc
PPE_TTL=10
HISTORY_MAX=120
HISTORY_AGE=1200

mkdir -p "$STATE_DIR" 2>/dev/null

read_file() {
	local value
	[ -r "$1" ] || return 1
	read -r value < "$1" 2>/dev/null || return 1
	printf '%s' "$value"
}

dt_string() {
	[ -e "$1" ] || return 1
	tr '\0' '\n' < "$1" 2>/dev/null | sed -n '1p'
}

read_num() {
	local value
	value=$(read_file "$1") || { printf '%s' '-1'; return; }
	case "$value" in
		''|*[!0-9-]*) printf '%s' '-1' ;;
		*) printf '%s' "$value" ;;
	esac
}

hwmon_temp() {
	local wanted="$1" h
	for h in /sys/class/hwmon/hwmon*; do
		[ -d "$h" ] || continue
		[ "$(read_file "$h/name")" = "$wanted" ] || continue
		read_num "$h/temp1_input"
		return
	done
	printf '%s' '-1'
}

hwmon_value() {
	local wanted="$1" file="$2" h
	for h in /sys/class/hwmon/hwmon*; do
		[ -d "$h" ] || continue
		[ "$(read_file "$h/name")" = "$wanted" ] || continue
		read_num "$h/$file"
		return
	done
	printf '%s' '-1'
}

thermal_trips() {
	local zone="$1" f t v warn=-1 hot=-1 crit=-1
	for f in "$zone"/trip_point_*_temp; do
		[ -r "$f" ] || continue
		t=$(read_file "${f%_temp}_type")
		v=$(read_num "$f")
		[ "$v" -ge 0 ] || continue
		case "$t" in
			critical)
				[ "$crit" -lt 0 ] && crit=$v
				;;
			hot)
				[ "$hot" -lt 0 ] && hot=$v
				;;
			active)
				# 高温降频/风扇档位: 取不低于 60°C 的最低档作为告警阈值
				if [ "$v" -ge 60000 ] && { [ "$warn" -lt 0 ] || [ "$v" -lt "$warn" ]; }; then
					warn=$v
				fi
				;;
		esac
	done
	printf '%s %s %s\n' "$warn" "$hot" "$crit"
}

add_string_list() {
	local key="$1" values="$2" item
	json_add_array "$key"
	for item in $values; do
		json_add_string "" "$item"
	done
	json_close_array
}

topology_ensure() {
	local compatible profile tmp stamp current
	compatible=$(dt_string /proc/device-tree/compatible)
	stamp="$STATE_DIR/topology.profile"
	tmp="$STATE_DIR/topology.tsv.$$"

	current=$(read_file "$stamp" 2>/dev/null)
	if [ "$current" = "$compatible" ] && [ -s "$STATE_DIR/topology.tsv" ]; then
		return 0
	fi

	case "$compatible" in
		bananapi,bpi-r4*)
			profile=r4
			;;
		*)
			profile=generic
			;;
	esac

	{
		case "$profile" in
			r4)
				printf 'P\t%s\t%s\n' sfp-wan 'SFP+ WAN'
				printf 'P\t%s\t%s\n' sfp-lan 'SFP+ LAN'
				printf 'P\t%s\t%s\n' wan 'RJ45 WAN'
				printf 'P\t%s\t%s\n' lan1 'GbE LAN1'
				printf 'P\t%s\t%s\n' lan2 'GbE LAN2'
				printf 'P\t%s\t%s\n' lan3 'GbE LAN3'
				printf 'P\t%s\t%s\n' lan4 'GbE LAN4'
				printf 'G\t%s\t%s\t%s\t%s\n' 2 sfp-wan 'SFP+ WAN' 0
				printf 'G\t%s\t%s\t%s\t%s\n' 1 sfp-lan 'SFP+ LAN' 0
				printf 'G\t%s\t%s\t%s\t%s\n' 0 eth0 'ESW / RJ45' 10000
				;;
			*)
				for current in $(ls /sys/class/net 2>/dev/null); do
					case "$current" in
						lo|br-*|docker*|veth*|pppoe-*|wlan*|sit*|ip6*|gre*|utun*) continue ;;
					esac
					printf 'P\t%s\t%s\n' "$current" "$current"
				done
				;;
		esac
	} > "$tmp"

	mv "$tmp" "$STATE_DIR/topology.tsv"
	printf '%s' "$compatible" > "$stamp"
}

ppe_cache_ensure() {
	local now stamp engine limit summary_file entries_file
	now=$(date +%s 2>/dev/null || echo 0)
	stamp=$(read_file "$STATE_DIR/ppe.stamp" 2>/dev/null)
	case "$stamp" in ''|*[!0-9]*) stamp=0 ;; esac
	if [ $((now - stamp)) -le "$PPE_TTL" ] &&
	   [ -s "$STATE_DIR/ppe-summary.tsv" ] &&
	   [ -s "$STATE_DIR/ppe-entries.tsv" ]; then
		return 0
	fi

	summary_file="$STATE_DIR/ppe-summary.tsv.$$"
	entries_file="$STATE_DIR/ppe-entries.tsv.$$"
	: > "$summary_file"
	: > "$entries_file"
	limit=400

	for engine in ppe0 ppe1 ppe2; do
		if [ ! -r "/sys/kernel/debug/$engine/entries" ]; then
			printf 'M\t%s\t-1\t-1\t-1\t-1\t-1\t0\n' "$engine" >> "$summary_file"
			continue
		fi
		awk -v engine="$engine" -v max="$limit" '
			BEGIN { FS = "[ \t]+"; OFS = "\t"; shown = 0 }
			/^[0-9a-fA-F]+ / {
				total++
				if ($2 == "BND") bound++; else unbound++
				orig = new = eth = vlan = packets = bytes = ""
				for (i = 1; i <= NF; i++) {
					if ($i ~ /^packets=/) {
						packets = substr($i, 9)
						if (packets ~ /^[0-9]+$/) total_packets += packets
					} else if ($i ~ /^bytes=/) {
						bytes = substr($i, 7)
						if (bytes ~ /^[0-9]+$/) total_bytes += bytes
					} else if ($i ~ /^orig=/) {
						orig = substr($i, 6)
					} else if ($i ~ /^new=/) {
						new = substr($i, 5)
					} else if ($i ~ /^eth=/) {
						eth = substr($i, 5)
					} else if ($i ~ /^vlan=/) {
						vlan = substr($i, 6)
					}
				}
				if (shown < max) {
					type = $3 " " $4
					printf "E\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", \
						engine, $1, $2, type, orig, new, eth, vlan, \
						(packets == "" ? 0 : packets), (bytes == "" ? 0 : bytes)
					shown++
				}
			}
			END {
				printf "M\t%s\t%d\t%d\t%d\t%.0f\t%.0f\t%d\n", \
					engine, total, bound, unbound, total_packets, total_bytes, shown
			}
		' "/sys/kernel/debug/$engine/entries" >> "$entries_file"
	done

	awk -F '\t' '$1 == "M" { print }' "$entries_file" >> "$summary_file"
	awk -F '\t' '$1 == "E"' "$entries_file" > "$entries_file.clean"
	mv "$entries_file.clean" "$entries_file"
	mv "$summary_file" "$STATE_DIR/ppe-summary.tsv"
	mv "$entries_file" "$STATE_DIR/ppe-entries.tsv"
	printf '%s' "$now" > "$STATE_DIR/ppe.stamp"
}

add_ppe_summary() {
	local kind engine total bound unbound packets bytes shown
	json_add_object ppe
	while IFS='	' read -r kind engine total bound unbound packets bytes shown; do
		[ "$kind" = "M" ] || continue
		json_add_object "$engine"
		json_add_int total "$total"
		json_add_int bound "$bound"
		json_add_int unbound "$unbound"
		json_add_int packets "$packets"
		json_add_int bytes "$bytes"
		json_close_object
	done < "$STATE_DIR/ppe-summary.tsv"
	json_close_object
}

cpu_ticks() {
	awk '
		/^cpu[0-9]+[ \t]/ {
			total = 0
			for (i = 2; i <= 9; i++)
				total += $i
			printf "%d\t%d\n", total, $5 + $6
		}
	' /proc/stat 2>/dev/null
}

update_cpu_history() {
	local now current usage hist
	now=$(date +%s 2>/dev/null || echo 0)
	current="$STATE_DIR/cpu-current.$$"
	hist="$STATE_DIR/cpu-history"
	cpu_ticks > "$current"

	if [ -s "$STATE_DIR/cpu-previous" ] && [ -s "$current" ]; then
		usage=$(awk -F '\t' '
			NR == FNR { old_total[FNR] = $1; old_idle[FNR] = $2; next }
			{
				dt = $1 - old_total[FNR]
				di = $2 - old_idle[FNR]
				if (dt > 0 && di >= 0 && di <= dt) {
					v = (1 - di / dt) * 100
					printf "%s%.1f", (sep ? "," : ""), v
					sep = ","
					measured = 1
				}
			}
			END { if (measured) print "" }
		' "$STATE_DIR/cpu-previous" "$current")
		if [ -n "$usage" ]; then
			printf '%s|%s\n' "$now" "$usage" >> "$hist"
		fi
	fi

	mv "$current" "$STATE_DIR/cpu-previous"
	if [ -s "$hist" ]; then
		awk -F '|' -v cutoff=$((now - HISTORY_AGE)) '$1 >= cutoff' "$hist" |
			tail -n "$HISTORY_MAX" > "$hist.$$"
		mv "$hist.$$" "$hist"
	fi
}

add_cpu_history() {
	local ts values value rest
	json_add_array cpu_history
	if [ -s "$STATE_DIR/cpu-history" ]; then
		while IFS='|' read -r ts values; do
			json_add_object
			json_add_int t "$ts"
			json_add_array u
			rest=$values
			while [ -n "$rest" ]; do
				case "$rest" in
					*,*)
						value=${rest%%,*}
						rest=${rest#*,}
						;;
					*)
						value=$rest
						rest=
						;;
				esac
				json_add_int u "$value"
			done
			json_close_array
			json_close_object
		done < "$STATE_DIR/cpu-history"
	fi
	json_close_array
}

add_status_fields() {
	local governor governor_list freq_list ticks

	governor=$(read_file "$CPU_POLICY/scaling_governor")
	governor_list=$(read_file "$CPU_POLICY/scaling_available_governors")
	freq_list=$(read_file "$CPU_POLICY/scaling_available_frequencies")
	update_cpu_history
	ppe_cache_ensure

	json_add_string model "$(dt_string /proc/device-tree/model)"
	json_add_string compatible "$(dt_string /proc/device-tree/compatible)"
	json_add_string hostname "$(read_file /proc/sys/kernel/hostname)"
	json_add_string kernel "$(uname -r)"
	json_add_int uptime "$(cut -d. -f1 /proc/uptime 2>/dev/null || echo -1)"
	json_add_int cpu_count "$(grep -c '^processor' /proc/cpuinfo 2>/dev/null || echo 0)"
	json_add_string cpu_model 'ARM Cortex-A73 (MT7988A)'
	json_add_string cpu_arch 'ARMv8 (aarch64)'
	json_add_int cpu_temp_mc "$(read_num /sys/class/thermal/thermal_zone0/temp)"
	set -- $(thermal_trips /sys/class/thermal/thermal_zone0)
	json_add_int cpu_temp_warn_mc "$1"
	json_add_int cpu_temp_hot_mc "$2"
	json_add_int cpu_temp_crit_mc "$3"
	json_add_int cpu_cur_freq "$(read_num "$CPU_POLICY/scaling_cur_freq")"
	json_add_int cpu_min_freq "$(read_num "$CPU_POLICY/scaling_min_freq")"
	json_add_int cpu_max_freq "$(read_num "$CPU_POLICY/scaling_max_freq")"
	json_add_int cpu_hw_freq "$(read_num "$CPU_POLICY/cpuinfo_cur_freq")"
	json_add_string cpu_governor "${governor:-unknown}"
	add_string_list cpu_available_governors "$governor_list"
	add_string_list cpu_available_freqs "$freq_list"

	ticks=$(cpu_ticks)
	json_add_array cpu_ticks
	set -- $ticks
	while [ "$#" -ge 2 ]; do
		json_add_object
		json_add_int total "$1"
		json_add_int idle "$2"
		json_close_object
		shift 2
	done
	json_close_array
	add_cpu_history

	json_add_int fan_pwm "$(hwmon_value pwmfan pwm1)"
	json_add_int fan_rpm "$(hwmon_value pwmfan fan1_input)"
	json_add_int sfp1_temp_mc "$(hwmon_temp sfp1)"
	json_add_int sfp1_temp_max_mc "$(hwmon_value sfp1 temp1_max)"
	json_add_int sfp1_temp_crit_mc "$(hwmon_value sfp1 temp1_crit)"
	json_add_int sfp1_temp_alarm "$(hwmon_value sfp1 temp1_crit_alarm)"
	json_add_int sfp2_temp_mc "$(hwmon_temp sfp2)"
	json_add_int sfp2_temp_max_mc "$(hwmon_value sfp2 temp1_max)"
	json_add_int sfp2_temp_crit_mc "$(hwmon_value sfp2 temp1_crit)"
	json_add_int sfp2_temp_alarm "$(hwmon_value sfp2 temp1_crit_alarm)"

	json_add_object clocks
	json_add_int npu_tops "$(read_num /sys/kernel/debug/clk/npu_tops_sel/clk_rate)"
	json_add_int ck_npu "$(read_num /sys/kernel/debug/clk/ck_npu_sel/clk_rate)"
	json_add_int ethdma_fe "$(read_num /sys/kernel/debug/clk/ethdma_fe_en/clk_rate)"
	json_close_object

	add_ppe_summary
}

add_ports_fields() {
	local kind port path speed carrier duplex operstate mac
	topology_ensure
	json_add_array ports
	while IFS='	' read -r kind port path; do
		[ "$kind" = "P" ] || continue
		[ -d "/sys/class/net/$port" ] || continue
		speed=$(read_num "/sys/class/net/$port/speed")
		carrier=$(read_file "/sys/class/net/$port/carrier")
		duplex=$(read_file "/sys/class/net/$port/duplex")
		operstate=$(read_file "/sys/class/net/$port/operstate")
		mac=$(read_file "/sys/class/net/$port/address")

		json_add_object
		json_add_string name "$port"
		json_add_string path "$path"
		json_add_string state "${operstate:-unknown}"
		json_add_boolean up "$([ "$carrier" = "1" ] && echo 1 || echo 0)"
		json_add_int speed_mbps "$speed"
		json_add_string duplex "${duplex:-unknown}"
		json_add_string mac "${mac:-}"
		json_add_int rx_bytes "$(read_num "/sys/class/net/$port/statistics/rx_bytes")"
		json_add_int tx_bytes "$(read_num "/sys/class/net/$port/statistics/tx_bytes")"
		json_add_int rx_packets "$(read_num "/sys/class/net/$port/statistics/rx_packets")"
		json_add_int tx_packets "$(read_num "/sys/class/net/$port/statistics/tx_packets")"
		json_add_int rx_errors "$(read_num "/sys/class/net/$port/statistics/rx_errors")"
		json_add_int tx_errors "$(read_num "/sys/class/net/$port/statistics/tx_errors")"
		json_add_int rx_dropped "$(read_num "/sys/class/net/$port/statistics/rx_dropped")"
		json_add_int tx_dropped "$(read_num "/sys/class/net/$port/statistics/tx_dropped")"
		json_close_object
	done < "$STATE_DIR/topology.tsv"
	json_close_array
}

add_gdm_fields() {
	local kind index ifname path fixed_speed speed carrier operstate
	local rx_bytes tx_bytes rx_packets tx_packets rx_errors tx_errors rx_dropped tx_dropped

	topology_ensure
	json_add_array gdm
	while IFS='	' read -r kind index ifname path fixed_speed; do
		[ "$kind" = "G" ] || continue
		[ -d "/sys/class/net/$ifname" ] || continue

		speed=$(read_num "/sys/class/net/$ifname/speed")
		[ "$speed" -gt 0 ] || speed=$fixed_speed
		carrier=$(read_file "/sys/class/net/$ifname/carrier")
		operstate=$(read_file "/sys/class/net/$ifname/operstate")
		rx_bytes=$(read_num "/sys/class/net/$ifname/statistics/rx_bytes")
		tx_bytes=$(read_num "/sys/class/net/$ifname/statistics/tx_bytes")
		rx_packets=$(read_num "/sys/class/net/$ifname/statistics/rx_packets")
		tx_packets=$(read_num "/sys/class/net/$ifname/statistics/tx_packets")
		rx_errors=$(read_num "/sys/class/net/$ifname/statistics/rx_errors")
		tx_errors=$(read_num "/sys/class/net/$ifname/statistics/tx_errors")
		rx_dropped=$(read_num "/sys/class/net/$ifname/statistics/rx_dropped")
		tx_dropped=$(read_num "/sys/class/net/$ifname/statistics/tx_dropped")

		json_add_object
		json_add_string gdm "GDM$index"
		json_add_string gmac "GMAC$index"
		json_add_string ppe "PPE$index"
		json_add_string interface "$ifname"
		json_add_string path "$path"
		json_add_string state "${operstate:-unknown}"
		json_add_boolean up "$([ "$carrier" = "1" ] && echo 1 || echo 0)"
		json_add_int speed_mbps "$speed"
		json_add_int rx_bytes "$rx_bytes"
		json_add_int tx_bytes "$tx_bytes"
		json_add_int rx_packets "$rx_packets"
		json_add_int tx_packets "$tx_packets"
		json_add_int rx_errors "$rx_errors"
		json_add_int tx_errors "$tx_errors"
		json_add_int rx_dropped "$rx_dropped"
		json_add_int tx_dropped "$tx_dropped"
		json_close_object
	done < "$STATE_DIR/topology.tsv"
	json_close_array
}

add_ppe_entries_fields() {
	local kind engine index state type orig new eth vlan packets bytes
	local available=0

	ppe_cache_ensure
	if awk -F '\t' '$1 == "M" && $3 >= 0 { found = 1 } END { exit !found }' "$STATE_DIR/ppe-summary.tsv"; then
		available=1
	fi

	json_add_boolean available "$available"
	json_add_int generated_at "$(read_file "$STATE_DIR/ppe.stamp")"
	json_add_object summary
	add_ppe_summary
	json_close_object
	json_add_array entries
	while IFS='	' read -r kind engine index state type orig new eth vlan packets bytes; do
		[ "$kind" = "E" ] || continue
		json_add_object
		json_add_string engine "$engine"
		json_add_string index "$index"
		json_add_string state "$state"
		json_add_string type "$type"
		json_add_string orig "$orig"
		json_add_string new_flow "$new"
		json_add_string eth "$eth"
		json_add_string vlan "$vlan"
		json_add_int packets "$packets"
		json_add_int bytes "$bytes"
		json_close_object
	done < "$STATE_DIR/ppe-entries.tsv"
	json_close_array
}

get_status() {
	json_init
	add_status_fields
	json_dump
}

get_ports() {
	json_init
	add_ports_fields
	json_dump
}

get_gdm() {
	json_init
	add_gdm_fields
	json_dump
}

get_ppe_entries() {
	json_init
	add_ppe_entries_fields
	json_dump
}

get_dashboard() {
	local payload="$1" scope=all
	if [ -z "$payload" ]; then
		IFS= read -r payload
	fi
	if [ -n "$payload" ]; then
		json_load "$payload"
		json_get_var scope scope
	fi
	case "$scope" in
		fast|gdm|ppe|all) ;;
		*) scope=all ;;
	esac

	json_init
	json_add_int generated_at "$(date +%s 2>/dev/null || echo 0)"
	json_add_string scope "$scope"
	case "$scope" in
		fast|all)
			json_add_object status
			add_status_fields
			json_close_object
			json_add_object ports
			add_ports_fields
			json_close_object
			;;
	esac
	case "$scope" in
		gdm|all)
			json_add_object gdm
			add_gdm_fields
			json_close_object
			;;
	esac
	case "$scope" in
		ppe|all)
			json_add_object ppe
			add_ppe_entries_fields
			json_close_object
			;;
	esac
	json_dump
}

set_cpu_settings() {
	local payload="$1" governor max_freq

	# rpcd(exec 后端) 通过 stdin 传递调用参数, 直接执行脚本时才用 $1
	if [ -z "$payload" ]; then
		IFS= read -r payload
	fi
	json_load "$payload"
	json_get_var governor governor
	json_get_var max_freq max_freq

	if [ -n "$governor" ] && grep -qw "$governor" "$CPU_POLICY/scaling_available_governors" 2>/dev/null; then
		echo "$governor" > "$CPU_POLICY/scaling_governor" 2>/dev/null || true
	else
		governor=""
	fi

	if [ -n "$max_freq" ] && grep -qw "$max_freq" "$CPU_POLICY/scaling_available_frequencies" 2>/dev/null; then
		echo "$max_freq" > "$CPU_POLICY/scaling_max_freq" 2>/dev/null || true
	else
		max_freq=""
	fi

	if [ -n "$governor" ] || [ -n "$max_freq" ]; then
		/sbin/uci -q set mtk_soc.cpu=mtk_soc
		[ -n "$governor" ] && /sbin/uci -q set mtk_soc.cpu.governor="$governor"
		[ -n "$max_freq" ] && /sbin/uci -q set mtk_soc.cpu.max_freq="$max_freq"
		/sbin/uci -q commit mtk_soc
	fi

	json_init
	json_add_boolean ok 1
	json_dump
}

case "$1" in
	list)
		echo '{"getStatus":{},"getPorts":{},"getGdm":{},"getPpeEntries":{},"getDashboard":{"scope":"String"},"setCpuSettings":{"governor":"String","max_freq":"Integer"}}'
		;;
	call)
		case "$2" in
			getStatus) get_status ;;
			getPorts) get_ports ;;
			getGdm) get_gdm ;;
			getPpeEntries) get_ppe_entries ;;
			getDashboard) get_dashboard "$3" ;;
			setCpuSettings) set_cpu_settings "$3" ;;
		esac
		;;
esac
