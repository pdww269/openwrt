config fancontrol 'settings'
	option enabled '1'
	option start_temp '45'
	option full_speed_temp '80'
	option hysteresis '5'
	option start_speed '25'
	option max_speed '100'
	option interval '5'
	option thermal_file 'auto'
	option thermal_zone 'auto'
	option fan_file 'auto'
	option fan_hwmon 'auto'
	option enable_file 'auto'
	option temp_div '1000'
	option kick_speed '60'
	option kick_ms '2000'
	option fail_safe_speed '100'
	option exit_speed '0'
	option debug '0'

