#!/bin/sh /etc/rc.common

START=99
STOP=10

COMPOSE_FILE=/usr/share/ha-proxy/compose.yaml
PROXY_DIR=/opt/docker/nginx-ha
CERTS_DIR=$PROXY_DIR/certs

service_enabled() {
	config_load ha-proxy
	config_get_bool enabled settings enabled 1
	[ "$enabled" = "1" ]
}

wait_for_docker() {
	for _ in $(seq 1 30); do
		[ -S /var/run/docker.sock ] && return 0
		sleep 2
	done
	return 1
}

compose() {
	if docker compose version >/dev/null 2>&1; then
		docker compose -f "$COMPOSE_FILE" "$@"
	else
		docker-compose -f "$COMPOSE_FILE" "$@"
	fi
}

remove_ca_private_key() {
	rm -f "$CERTS_DIR/ca.key"
}

migrate_container() {
	local name="$1"
	local project

	docker inspect "$name" >/dev/null 2>&1 || return 0
	project="$(docker inspect "$name" \
		--format '{{index .Config.Labels "com.docker.compose.project"}}' \
		2>/dev/null)"
	[ "$project" = "ha-proxy" ] || docker rm -f "$name" >/dev/null 2>&1 || true
}

start() {
	service_enabled || return 0

	if ! mountpoint -q /opt/docker || ! mountpoint -q /mnt/data; then
		logger -t ha-proxy "persistent NVMe mounts are not ready"
		return 1
	fi
	wait_for_docker || {
		logger -t ha-proxy "Docker socket did not become ready"
		return 1
	}

	mkdir -p /mnt/data/ha-config "$PROXY_DIR" "$CERTS_DIR"
	if [ ! -s "$PROXY_DIR/nginx.conf" ]; then
		cp /usr/share/ha-proxy/nginx.conf "$PROXY_DIR/nginx.conf"
	fi
	chmod 0700 "$CERTS_DIR"
	remove_ca_private_key

	migrate_container homeassistant
	migrate_container nginx-ha
	compose up -d homeassistant

	if [ -s "$CERTS_DIR/ca.crt" ] &&
	   [ -s "$CERTS_DIR/server.crt" ] &&
	   [ -s "$CERTS_DIR/server.key" ]; then
		compose up -d nginx-ha
	else
		logger -t ha-proxy "Nginx not started: certificate files are incomplete"
		compose stop nginx-ha >/dev/null 2>&1 || true
	fi
}

stop() {
	service_enabled || return 0
	compose stop nginx-ha homeassistant >/dev/null 2>&1 || true
}
