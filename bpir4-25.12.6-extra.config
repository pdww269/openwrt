# BPI-R4 custom package additions for OpenWrt 25.12.6.
CONFIG_VERSION_CODE="bpir4-25.12.6-au-be14-r9"
CONFIG_PACKAGE_libsensors=y
CONFIG_PACKAGE_lm-sensors=y
# CONFIG_PACKAGE_lm-sensors-detect is not set
CONFIG_PACKAGE_fancontrol=y
CONFIG_PACKAGE_luci-app-fancontrol=y
CONFIG_PACKAGE_luci-i18n-fancontrol-zh-cn=y
CONFIG_PACKAGE_luci-app-temperature-status=y
CONFIG_PACKAGE_luci-i18n-temperature-status-zh-cn=y
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y
CONFIG_PACKAGE_luci-i18n-aurora-config-zh-cn=y
CONFIG_PACKAGE_luci-theme-glass=y
CONFIG_PACKAGE_luci-i18n-glass-zh-cn=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
CONFIG_PACKAGE_luci-app-tasks=y
